# Shared secret key for JWT tokens across all services
SECRET_KEY=supersecretkey

# API Gateway public URL (used for generating download links)
# Change to your actual domain in production
API_GATEWAY_URL=http://localhost:8000

# Analytics database. Keep the password and URL in sync in production.
ANALYTICS_DB_PASSWORD=pass
ANALYTICS_DATABASE_URL=postgresql://analytics:pass@db/analytics
ANALYTICS_SALT=replace-with-a-long-random-value
