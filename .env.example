# REQUIRED. Shared secret key for JWT tokens across all services.
# Generate: openssl rand -hex 32  (never commit the real value)
SECRET_KEY=change-me

# REQUIRED. Secret for service-to-service /internal endpoints.
# Generate: openssl rand -hex 32
SHARED_SERVICE_SECRET=change-me

# Postgres superuser password (only used on first DB init and by analytics-db-init)
POSTGRES_PASSWORD=pass

# Swagger UI at /api/docs. Keep false in production.
ENABLE_API_DOCS=true

# API Gateway public URL (used for generating download links)
# Change to your actual domain in production
API_GATEWAY_URL=http://localhost:8000

# Analytics database. Keep the password and URL in sync in production.
ANALYTICS_DB_PASSWORD=pass
ANALYTICS_DATABASE_URL=postgresql://analytics:pass@db/analytics
ANALYTICS_SALT=replace-with-a-long-random-value

# AI Review Service (OpenAI-compatible Chat Completions API)
AI_API_URL=https://api.openai.com/v1
OPEN_AI_KEY=
# Alternatively, AI_API_KEY can be used and takes precedence over OPEN_AI_KEY.
AI_API_KEY=
AI_MODEL=gpt-5.5
AI_TIMEOUT_SECONDS=120

# ORCID OAuth. Use sandbox while developing; production requires an exact HTTPS redirect URI.
ORCID_ENV=production
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_REDIRECT_URI=https://journal.tau-edu.kz/api/auth/orcid/callback
FRONTEND_URL=https://journal.tau-edu.kz
